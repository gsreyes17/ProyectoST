{
  "name": "seguridad-transversal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm --filter @proyectost/seguridad-backend start",
    "build": "node scripts/build.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "db:migrate": "node scripts/migrate-databases.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "demo:users": "node scripts/create-demo-users.mjs",
    "test": "node --test --test-concurrency=1 apps/app-seguridad/backend/tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "test:integration": "node scripts/check-integration.mjs",
    "java:setup": "node scripts/setup-java.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0"
  },
  "packageManager": "pnpm@11.18.0"
}
