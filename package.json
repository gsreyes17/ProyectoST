{
  "name": "seguridad-transversal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start --workspace @proyectost/seguridad-backend",
    "build": "node scripts/build.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "db:migrate": "node scripts/migrate-databases.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "demo:users": "node scripts/create-demo-users.mjs",
    "test": "node --test --test-concurrency=1 apps/app-seguridad/backend/tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "test:integration": "node scripts/check-integration.mjs",
    "java:setup": "node scripts/setup-java.mjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "otpauth": "^9.4.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "vite": "^7.1.0"
  },
  "workspaces": [
    "apps/*/frontend",
    "apps/app-seguridad/backend",
    "apps/app-facturacion/backend"
  ]
}
